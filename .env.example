# Supabase Configuration
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-key-here
SUPABASE_PUBLISH_KEY=your-anon-key-here

# Embedding Configuration (Generic - works with any OpenAI-compatible API)
# You can use OpenRouter, z.ai, or any other OpenAI-compatible provider
EMBEDDING_API_KEY=your-embedding-api-key-here
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIMENSIONS=1536

# Metadata Configuration (Generic - works with any OpenAI-compatible API)
# You can use z.ai, OpenRouter, or any other OpenAI-compatible provider
METADATA_API_KEY=your-metadata-api-key-here
METADATA_BASE_URL=https://api.z.ai/api/coding/paas/v4
METADATA_MODEL=glm-4.7

# Legacy Variables (for backward compatibility - will be used if new vars not set)
# OPENROUTER_API_KEY=sk-or-v1-your-api-key-here
# ZAI_API_KEY=your-zai-api-key-here

# Obsidian Configuration
# Path to your Obsidian vault
OBSIDIAN_VAULT_PATH=./SecondBrain

# File Logging Configuration
# Enable detailed logging to files in the Logs directory (true/false)
# When enabled, logs are written to Logs/second_brain_YYYY-MM-DD.log
# Useful for debugging timeout issues or other server problems
FILE_LOGGING=false

# Semantic Folder Placement
# Enable to automatically place notes in folders based on content analysis
# Disable (default) to place all new notes in -To-Sort- folder
SEMANTIC_FOLDER_PLACEMENT=false

# Duplicate Handling Strategy
# Options: "prompt" (ask user/LLM), "skip" (auto-skip), "overwrite" (auto-overwrite)
DUPLICATE_HANDLING_MODE=prompt

# Use MCP Tasks for interactive mode (experimental)
# If false, uses simple response pattern (LLM retries with force parameter)
# Default to simple mode (false) for broad client compatibility
DUPLICATE_USE_TASKS=false

# Custom tracking parameters to remove from URLs for heuristic matching
# Comma-separated list of parameter names
# Example: utm_source,utm_medium,fbclid,gclid
DUPLICATE_TRACKING_PARAMS=